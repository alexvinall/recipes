<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <main class="container stack">
    <p><a href="{{ '/' | url }}">← Back to all recipes</a></p>
    <article class="recipe">
      <time datetime="{{ date | htmlDate }}">{{ date | date('MMMM d, yyyy') }}</time>
      {{ content | safe }}
      <p class="tags">Tags: {% for tag in tags %}<a href="{{ ('/tags/' + (tag | slug) + '/') | url }}">{{ tag }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
    </article>
  </main>
</body>
</html>
