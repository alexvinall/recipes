---
title: "Alex's recipes"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <main class="container stack">
    <header class="page-header stack">
      <h1>{{ title }}</h1>
      <p class="lede">Simple, flavourful recipes to cook at home.</p>
      <input id="searchInput" type="search" placeholder="Search recipes" aria-label="Search recipes">
    </header>

    <section aria-live="polite" aria-label="Search results">
      <ul id="searchResults" class="recipe-grid" hidden></ul>
    </section>

    <section>
      <ul class="recipe-grid">
      {% for recipe in collections.recipes %}
        <li class="recipe-card">
          <a class="recipe-link" href="{{ recipe.url | url }}">
            <h2>{{ recipe.data.title }}</h2>
            <p>Published <time datetime="{{ recipe.date | htmlDate }}">{{ recipe.date | date('MMMM d, yyyy') }}</time></p>
          </a>
        </li>
      {% endfor %}
      </ul>
    </section>

    <script>
    const searchInput = document.getElementById('searchInput');
    const resultsList = document.getElementById('searchResults');
    let index = [];
    fetch('{{ "/search.json" | url }}')
      .then(r => r.json())
      .then(data => index = data);

    function renderResults(items) {
      resultsList.innerHTML = '';
      if (items.length === 0) {
        resultsList.hidden = true;
        return;
      }
      items.forEach(item => {
        const li = document.createElement('li');
        li.className = 'recipe-card';

        const a = document.createElement('a');
        a.className = 'recipe-link';
        a.href = item.url;

        const title = document.createElement('h2');
        title.textContent = item.title;

        a.appendChild(title);
        li.appendChild(a);
        resultsList.appendChild(li);
      });
      resultsList.hidden = false;
    }

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.trim().toLowerCase();
      if (!query) {
        renderResults([]);
        return;
      }
      const matches = index.filter(r =>
        r.title.toLowerCase().includes(query) ||
        r.content.toLowerCase().includes(query)
      );
      renderResults(matches);
    });
    </script>
  </main>
</body>
</html>
